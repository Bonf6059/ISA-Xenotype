<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Royalty</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/FactionDef[defName="OutlanderRefugee"]/xenotypeSet/xenotypeChances</xpath>
					<value>
						<Askbarn>0.025</Askbarn>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/FactionDef[defName="Empire"]/xenotypeSet/xenotypeChances</xpath>
					<value>
						<Askbarn>0.025</Askbarn>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/xenotypeSet/xenotypeChances</xpath>
		<value>
						<Askbarn>0.025</Askbarn>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/FactionDef[defName="Pirate"]/xenotypeSet/xenotypeChances</xpath>
		<value>
						<Askbarn>0.025</Askbarn>
		</value>
	</Operation>
	

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Ideology</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/FactionDef[defName="Beggars"]/xenotypeSet/xenotypeChances</xpath>
					<value>
						<Askbarn>0.025</Askbarn>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/FactionDef[defName="Pilgrims"]/xenotypeSet/xenotypeChances</xpath>
					<value>
						<Askbarn>0.025</Askbarn>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>
